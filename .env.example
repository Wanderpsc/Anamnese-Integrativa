git# Configurações da Aplicação
REACT_APP_NAME="Anamnese Integrativa"
REACT_APP_VERSION="2.0.0"

# Autenticação
REACT_APP_AUTH_ENABLED=false
REACT_APP_SESSION_TIMEOUT=3600000

# APIs Externas (quando implementar backend)
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_AI_API_KEY=your_ai_api_key_here

# Google Vision AI (para análise de imagens)
REACT_APP_GOOGLE_VISION_API_KEY=your_google_vision_key

# OpenAI (para análise avançada)
REACT_APP_OPENAI_API_KEY=your_openai_key

# Firebase (opcional - para backend futuro)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Analytics
REACT_APP_GOOGLE_ANALYTICS_ID=

# Configurações de Deploy
REACT_APP_DEPLOY_ENV=development
REACT_APP_PUBLIC_URL=

# Feature Flags
REACT_APP_ENABLE_DARK_MODE=true
REACT_APP_ENABLE_PWA=true
REACT_APP_ENABLE_OFFLINE_MODE=true
REACT_APP_ENABLE_AI_ANALYSIS=false
# Forçar a tela de login sempre que a aplicação for carregada (true/false)
REACT_APP_FORCE_LOGIN_ON_START=false
# Chave para link do proprietário (modo edição)
REACT_APP_OWNER_EDIT_KEY=changeme-ownermode
