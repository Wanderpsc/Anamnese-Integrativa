import { useState, useEffect } from 'react';
import { useNavigate, useParams } from 'react-router-dom';
import {
  Container,
  Paper,
  Typography,
  TextField,
  Button,
  Box,
  Grid,
  MenuItem,
  FormControl,
  InputLabel,
  Select,
  Divider,
  Alert,
  Stack,
  Accordion,
  AccordionSummary,
  AccordionDetails,
} from '@mui/material';
import {
  Save as SaveIcon,
  Clear as ClearIcon,
  ExpandMore as ExpandMoreIcon,
  OpenInNew as OpenInNewIcon,
  Download as DownloadIcon,
  Upload as UploadIcon,
} from '@mui/icons-material';
import { ESTADOS_CIDADES } from '../data/estadosCidades';
import SPREADSHEETS from '../config/spreadsheets';
import IridologyAnalysis from '../components/IridologyAnalysis';
import ClinicalSignsChecklistForm from '../components/ClinicalSignsChecklistForm';
import VitalSignsAnalysis from '../components/VitalSignsAnalysis';
import ScrollToTop from '../components/ScrollToTop';

export default function AnamneseForm() {
  const navigate = useNavigate();
  const { id } = useParams();
  const [formData, setFormData] = useState({
    // Identificação
    q01_nome: '',
    q02_data_nasc: '',
    q03_idade: '',
    q04_sexo: '',
    q05_estado_civil: '',
    q06_profissao: '',
    q07_endereco: '',
    q08_cidade: '',
    q09_estado: '',
    q10_cep: '',
    q11_telefone: '',
    q12_email: '',
    q13_rg: '',
    q14_cpf: '',
    q14_data_retorno: '',
    q14_comparecimento_confirmado: false,
    q14_historico_comparecimentos: [],
    
    // Queixa Principal
    q15_queixa_principal: '',
    q16_tempo_problema: '',
    q17_tratamentos_anteriores: '',
    
    // Histórico Familiar
    q18_doencas_familia: '',
    q19_pais_vivos: '',
    q20_doencas_pais: '',
    
    // Histórico Pessoal
    q21_cirurgias: '',
    q22_hospitalizacoes: '',
    q23_alergias: '',
    q24_medicamentos_uso: '',
    q25_doencas_cronicas: '',
    
    // Hábitos de Vida
    q26_tabagismo: '',
    q27_etilismo: '',
    q28_atividade_fisica: '',
    q29_frequencia_exercicio: '',
    
    // Alimentação
    q30_cafe_manha: '',
    q31_almoco: '',
    q32_jantar: '',
    q33_lanches: '',
    q34_agua_dia: '',
    q35_restricoes_alimentares: '',
    
    // Sono e Repouso
    q36_horas_sono: '',
    q37_qualidade_sono: '',
    q38_acorda_noite: '',
    
    // Sistema Digestivo
    q39_intestino: '',
    q40_gases: '',
    q41_azia: '',
    q42_nauseas: '',
    
    // Sistema Urinário
    q43_urina_frequencia: '',
    q44_cor_urina: '',
    q45_ardor_urinar: '',
    
    // Outros Sintomas
    q46_dores: '',
    q47_cansaco: '',
    q48_estresse: '',
    q49_ansiedade: '',
    q50_observacoes: '',
    
    // Análise de Iridologia
    iridologyAnalysis: null,
    
    // Análise de Sinais Vitais
    vitalSignsAnalysis: null,
    
    // Checklist de Sinais Clínicos
    clinicalSignsChecklist: null,
    
    // Biorressonância
    biorresonanciaBarraFile: null,
    biorresonanciaBarraAnalysis: '',
    biorresonanciaAuricularFile: null,
    biorresonanciaAuricularAnalysis: '',
  });

  const [selectedEstado, setSelectedEstado] = useState('');
  const [uploadingBarra, setUploadingBarra] = useState(false);
  const [uploadingAuricular, setUploadingAuricular] = useState(false);

  // Carregar dados da anamnese se estiver editando
  useEffect(() => {
    if (id) {
      const anamneses = JSON.parse(localStorage.getItem('anamneses') || '[]');
      const anamneseToEdit = anamneses.find(a => String(a.id) === String(id));
      
      if (anamneseToEdit) {
        setFormData(anamneseToEdit);
        if (anamneseToEdit.q09_estado) {
          setSelectedEstado(anamneseToEdit.q09_estado);
        }
      }
    }
  }, [id]);

  // Função para calcular idade a partir da data de nascimento
  const calculateAge = (birthDate) => {
    if (!birthDate) return '';
    
    const today = new Date();
    const birth = new Date(birthDate);
    
    let age = today.getFullYear() - birth.getFullYear();
    const monthDiff = today.getMonth() - birth.getMonth();
    
    // Ajusta se ainda não fez aniversário este ano
    if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birth.getDate())) {
      age--;
    }
    
    return age >= 0 ? age : '';
  };

  const handleChange = (field, value) => {
    setFormData(prev => {
      const updated = { ...prev, [field]: value };
      
      // Calcula idade automaticamente quando a data de nascimento muda
      if (field === 'q02_data_nasc') {
        updated.q03_idade = calculateAge(value);
      }
      
      return updated;
    });
  };

  const handleEstadoChange = (value) => {
    setSelectedEstado(value);
    handleChange('q09_estado', value);
    handleChange('q08_cidade', ''); // Limpa cidade ao mudar estado
  };

  const handleSubmit = (e) => {
    e.preventDefault();
    
    const anamneses = JSON.parse(localStorage.getItem('anamneses') || '[]');
    
    if (id) {
      // Modo edição: atualizar anamnese existente
      const index = anamneses.findIndex(a => String(a.id) === String(id));
      if (index !== -1) {
        anamneses[index] = {
          ...formData,
          id: anamneses[index].id,
          createdAt: anamneses[index].createdAt,
          updatedAt: new Date().toISOString(),
        };
        localStorage.setItem('anamneses', JSON.stringify(anamneses));
        alert('Anamnese atualizada com sucesso!');
      }
    } else {
      // Modo criação: adicionar nova anamnese
      const newAnamnese = {
        ...formData,
        id: Date.now(),
        createdAt: new Date().toISOString(),
      };
      anamneses.push(newAnamnese);
      localStorage.setItem('anamneses', JSON.stringify(anamneses));
      alert('Anamnese salva com sucesso!');
    }
    
    navigate('/dashboard');
  };

  const handleClear = () => {
    setFormData({
      q01_nome: '', q02_data_nasc: '', q03_idade: '', q04_sexo: '', q05_estado_civil: '',
      q06_profissao: '', q07_endereco: '', q08_cidade: '', q09_estado: '', q10_cep: '',
      q11_telefone: '', q12_email: '', q13_rg: '', q14_cpf: '', q15_queixa_principal: '',
      q16_tempo_problema: '', q17_tratamentos_anteriores: '', q18_doencas_familia: '',
      q19_pais_vivos: '', q20_doencas_pais: '', q21_cirurgias: '', q22_hospitalizacoes: '',
      q23_alergias: '', q24_medicamentos_uso: '', q25_doencas_cronicas: '', q26_tabagismo: '',
      q27_etilismo: '', q28_atividade_fisica: '', q29_frequencia_exercicio: '', q30_cafe_manha: '',
      q31_almoco: '', q32_jantar: '', q33_lanches: '', q34_agua_dia: '',
      q35_restricoes_alimentares: '', q36_horas_sono: '', q37_qualidade_sono: '',
      q38_acorda_noite: '', q39_intestino: '', q40_gases: '', q41_azia: '', q42_nauseas: '',
      q43_urina_frequencia: '', q44_cor_urina: '', q45_ardor_urinar: '', q46_dores: '',
      q47_cansaco: '', q48_estresse: '', q49_ansiedade: '', q50_observacoes: '',
      iridologyAnalysis: null,
      vitalSignsAnalysis: null,
      clinicalSignsChecklist: null,
      biorresonanciaBarraFile: null,
      biorresonanciaBarraAnalysis: '',
      biorresonanciaAuricularFile: null,
      biorresonanciaAuricularAnalysis: '',
    });
    setSelectedEstado('');
  };

  const handleOpenSheet = (url) => {
    window.open(url, '_blank');
  };

  const handleImportSheet = (exportCsv) => {
    navigate(`/data-import?importUrl=${encodeURIComponent(exportCsv)}`);
  };

  const handleBiorresonanciaBarraUpload = async (event) => {
    const file = event.target.files[0];
    if (!file) return;

    setUploadingBarra(true);
    
    try {
      const reader = new FileReader();
      reader.onload = async (e) => {
        const content = e.target.result;
        
        // Salvar arquivo
        handleChange('biorresonanciaBarraFile', {
          name: file.name,
          type: file.type,
          size: file.size,
          content: content
        });

        // Análise simples do conteúdo
        const analysis = `Arquivo carregado: ${file.name}\n` +
                        `Tipo: Biorressonância I (BARRA)\n` +
                        `Tamanho: ${(file.size / 1024).toFixed(2)} KB\n` +
                        `Data: ${new Date().toLocaleString('pt-BR')}\n\n` +
                        `Análise preliminar realizada. Aguarde processamento completo.`;
        
        handleChange('biorresonanciaBarraAnalysis', analysis);
        alert('Resultado de Biorressonância I (BARRA) carregado com sucesso!');
      };
      
      reader.readAsText(file);
    } catch (error) {
      console.error('Erro ao carregar arquivo:', error);
      alert('Erro ao carregar arquivo. Tente novamente.');
    } finally {
      setUploadingBarra(false);
    }
  };

  const handleBiorresonanciaAuricularUpload = async (event) => {
    const file = event.target.files[0];
    if (!file) return;

    setUploadingAuricular(true);
    
    try {
      const reader = new FileReader();
      reader.onload = async (e) => {
        const content = e.target.result;
        
        // Salvar arquivo
        handleChange('biorresonanciaAuricularFile', {
          name: file.name,
          type: file.type,
          size: file.size,
          content: content
        });

        // Análise simples do conteúdo
        const analysis = `Arquivo carregado: ${file.name}\n` +
                        `Tipo: Biorressonância II (AURICULAR)\n` +
                        `Tamanho: ${(file.size / 1024).toFixed(2)} KB\n` +
                        `Data: ${new Date().toLocaleString('pt-BR')}\n\n` +
                        `Análise preliminar realizada. Aguarde processamento completo.`;
        
        handleChange('biorresonanciaAuricularAnalysis', analysis);
        alert('Resultado de Biorressonância II (AURICULAR) carregado com sucesso!');
      };
      
      reader.readAsText(file);
    } catch (error) {
      console.error('Erro ao carregar arquivo:', error);
      alert('Erro ao carregar arquivo. Tente novamente.');
    } finally {
      setUploadingAuricular(false);
    }
  };

  return (
    <Container maxWidth="lg" sx={{ mt: 4, mb: 4 }}>
      <Paper sx={{ p: 4 }}>
        <Typography variant="h4" gutterBottom color="primary">
          {id ? 'Editar Anamnese Integrativa' : 'Nova Anamnese Integrativa'}
        </Typography>
        
        <Typography variant="body2" color="text.secondary" paragraph>
          {id ? 'Atualize os campos necessários da avaliação do paciente' : 'Preencha todos os campos necessários para uma avaliação completa do paciente'}
        </Typography>

        <form onSubmit={handleSubmit}>
          {/* Identificação - PRIMEIRO */}
          <Box sx={{ mb: 4, p: 3, borderRadius: 2, backgroundColor: '#e3f2fd', border: '2px solid #1976d2' }}>
            <Typography variant="h6" gutterBottom sx={{ color: '#1976d2', fontWeight: 600 }}>
              📋 Identificação
            </Typography>
            <Divider sx={{ mb: 2, borderColor: '#1976d2' }} />
            
            <Grid container spacing={2}>
              <Grid item xs={12} md={8}>
                <TextField
                  fullWidth
                  label="Nome Completo *"
                  value={formData.q01_nome}
                  onChange={(e) => handleChange('q01_nome', e.target.value)}
                  required
                />
              </Grid>
              <Grid item xs={12} md={4}>
                <TextField
                  fullWidth
                  type="date"
                  label="Data de Nascimento *"
                  InputLabelProps={{ shrink: true }}
                  value={formData.q02_data_nasc}
                  onChange={(e) => handleChange('q02_data_nasc', e.target.value)}
                  required
                />
              </Grid>
              
              <Grid item xs={12} md={2}>
                <TextField
                  fullWidth
                  label="Idade"
                  type="number"
                  value={formData.q03_idade}
                  disabled
                  InputProps={{
                    readOnly: true,
                  }}
                  helperText="Calculado automaticamente"
                />
              </Grid>
              <Grid item xs={12} md={3}>
                <FormControl fullWidth>
                  <InputLabel>Sexo</InputLabel>
                  <Select
                    value={formData.q04_sexo}
                    label="Sexo"
                    onChange={(e) => handleChange('q04_sexo', e.target.value)}
                  >
                    <MenuItem value="Masculino">Masculino</MenuItem>
                    <MenuItem value="Feminino">Feminino</MenuItem>
                    <MenuItem value="Outro">Outro</MenuItem>
                  </Select>
                </FormControl>
              </Grid>
              <Grid item xs={12} md={4}>
                <FormControl fullWidth>
                  <InputLabel>Estado Civil</InputLabel>
                  <Select
                    value={formData.q05_estado_civil}
                    label="Estado Civil"
                    onChange={(e) => handleChange('q05_estado_civil', e.target.value)}
                  >
                    <MenuItem value="Solteiro(a)">Solteiro(a)</MenuItem>
                    <MenuItem value="Casado(a)">Casado(a)</MenuItem>
                    <MenuItem value="Divorciado(a)">Divorciado(a)</MenuItem>
                    <MenuItem value="Viúvo(a)">Viúvo(a)</MenuItem>
                    <MenuItem value="União Estável">União Estável</MenuItem>
                  </Select>
                </FormControl>
              </Grid>
              <Grid item xs={12} md={3}>
                <TextField
                  fullWidth
                  label="Profissão"
                  value={formData.q06_profissao}
                  onChange={(e) => handleChange('q06_profissao', e.target.value)}
                />
              </Grid>

              <Grid item xs={12} md={8}>
                <TextField
                  fullWidth
                  label="Endereço"
                  value={formData.q07_endereco}
                  onChange={(e) => handleChange('q07_endereco', e.target.value)}
                />
              </Grid>
              <Grid item xs={12} md={4}>
                <TextField
                  fullWidth
                  label="CEP"
                  value={formData.q10_cep}
                  onChange={(e) => handleChange('q10_cep', e.target.value)}
                />
              </Grid>

              <Grid item xs={12} md={3}>
                <FormControl fullWidth>
                  <InputLabel>Estado</InputLabel>
                  <Select
                    value={selectedEstado}
                    label="Estado"
                    onChange={(e) => handleEstadoChange(e.target.value)}
                  >
                    {Object.keys(ESTADOS_CIDADES).map(uf => (
                      <MenuItem key={uf} value={uf}>{uf}</MenuItem>
                    ))}
                  </Select>
                </FormControl>
              </Grid>
              <Grid item xs={12} md={5}>
                <FormControl fullWidth disabled={!selectedEstado}>
                  <InputLabel>Cidade</InputLabel>
                  <Select
                    value={formData.q08_cidade}
                    label="Cidade"
                    onChange={(e) => handleChange('q08_cidade', e.target.value)}
                  >
                    {selectedEstado && ESTADOS_CIDADES[selectedEstado]?.map(cidade => (
                      <MenuItem key={cidade} value={cidade}>{cidade}</MenuItem>
                    ))}
                  </Select>
                </FormControl>
              </Grid>
              <Grid item xs={12} md={4}>
                <TextField
                  fullWidth
                  label="Telefone"
                  value={formData.q11_telefone}
                  onChange={(e) => handleChange('q11_telefone', e.target.value)}
                />
              </Grid>

              <Grid item xs={12} md={6}>
                <TextField
                  fullWidth
                  label="E-mail"
                  type="email"
                  value={formData.q12_email}
                  onChange={(e) => handleChange('q12_email', e.target.value)}
                />
              </Grid>
              <Grid item xs={12} md={3}>
                <TextField
                  fullWidth
                  label="RG"
                  value={formData.q13_rg}
                  onChange={(e) => handleChange('q13_rg', e.target.value)}
                />
              </Grid>
              <Grid item xs={12} md={3}>
                <TextField
                  fullWidth
                  label="CPF"
                  value={formData.q14_cpf}
                  onChange={(e) => handleChange('q14_cpf', e.target.value)}
                />
              </Grid>
              
              <Grid item xs={12}>
                <Divider sx={{ my: 2 }} />
                <Typography variant="subtitle1" sx={{ mb: 2, fontWeight: 600, color: '#1976d2' }}>
                  📅 Agendamento de Retorno
                </Typography>
              </Grid>
              
              <Grid item xs={12} md={4}>
                <TextField
                  fullWidth
                  type="date"
                  label="Data de Retorno"
                  InputLabelProps={{ shrink: true }}
                  value={formData.q14_data_retorno}
                  onChange={(e) => handleChange('q14_data_retorno', e.target.value)}
                  helperText="Agende a próxima consulta"
                />
              </Grid>
              
              <Grid item xs={12} md={4}>
                <Button
                  fullWidth
                  variant={formData.q14_comparecimento_confirmado ? "contained" : "outlined"}
                  color={formData.q14_comparecimento_confirmado ? "success" : "primary"}
                  onClick={() => {
                    const novoStatus = !formData.q14_comparecimento_confirmado;
                    const historico = formData.q14_historico_comparecimentos || [];
                    
                    if (novoStatus) {
                      // Confirmando comparecimento
                      historico.push({
                        data: new Date().toISOString(),
                        tipo: 'confirmacao',
                        observacao: 'Comparecimento confirmado'
                      });
                    }
                    
                    setFormData({
                      ...formData,
                      q14_comparecimento_confirmado: novoStatus,
                      q14_historico_comparecimentos: historico
                    });
                  }}
                  sx={{ height: '56px' }}
                >
                  {formData.q14_comparecimento_confirmado ? '✓ Comparecimento Confirmado' : 'Confirmar Comparecimento'}
                </Button>
              </Grid>
              
              <Grid item xs={12} md={4}>
                <Alert severity={formData.q14_comparecimento_confirmado ? "success" : "info"} sx={{ height: '56px', display: 'flex', alignItems: 'center' }}>
                  {formData.q14_comparecimento_confirmado ? 'Presença registrada' : 'Aguardando confirmação'}
                </Alert>
              </Grid>
              
              {formData.q14_historico_comparecimentos && formData.q14_historico_comparecimentos.length > 0 && (
                <Grid item xs={12}>
                  <Typography variant="caption" color="text.secondary">
                    Histórico: {formData.q14_historico_comparecimentos.length} registro(s) de comparecimento
                  </Typography>
                </Grid>
              )}
            </Grid>
          </Box>

          {/* Botões de Planilhas */}
          <Box sx={{ mb: 4, display: 'flex', gap: 2, flexWrap: 'wrap' }} aria-label="planilhas-panel">
            {SPREADSHEETS.map((sheet, index) => (
              <Button
                key={index}
                variant="outlined"
                startIcon={<OpenInNewIcon />}
                onClick={() => handleOpenSheet(sheet.url)}
                sx={{ 
                  textTransform: 'none',
                  borderRadius: 2,
                  px: 2
                }}
                aria-label={`open-sheet-${index}`}
              >
                {sheet.label}
              </Button>
            ))}
          </Box>

          {/* Queixa Principal */}
          <Box sx={{ mb: 4, p: 3, borderRadius: 2, backgroundColor: '#ffebee', border: '2px solid #d32f2f' }}>
            <Typography variant="h6" gutterBottom sx={{ color: '#d32f2f', fontWeight: 600 }}>
              🩺 Queixa Principal
            </Typography>
            <Divider sx={{ mb: 2, borderColor: '#d32f2f' }} />
            
            <Grid container spacing={2}>
              <Grid item xs={12}>
                <TextField
                  fullWidth
                  multiline
                  rows={3}
                  label="Qual é a queixa principal? *"
                  value={formData.q15_queixa_principal}
                  onChange={(e) => handleChange('q15_queixa_principal', e.target.value)}
                  required
                />
              </Grid>
              <Grid item xs={12} md={6}>
                <TextField
                  fullWidth
                  label="Há quanto tempo?"
                  value={formData.q16_tempo_problema}
                  onChange={(e) => handleChange('q16_tempo_problema', e.target.value)}
                />
              </Grid>
              <Grid item xs={12} md={6}>
                <TextField
                  fullWidth
                  label="Tratamentos anteriores"
                  value={formData.q17_tratamentos_anteriores}
                  onChange={(e) => handleChange('q17_tratamentos_anteriores', e.target.value)}
                />
              </Grid>
            </Grid>
          </Box>

          {/* Histórico Familiar */}
          <Box sx={{ mb: 4, p: 3, borderRadius: 2, backgroundColor: '#f3e5f5', border: '2px solid #7b1fa2' }}>
            <Typography variant="h6" gutterBottom sx={{ color: '#7b1fa2', fontWeight: 600 }}>
              👨‍👩‍👧‍👦 Histórico Familiar
            </Typography>
            <Divider sx={{ mb: 2, borderColor: '#7b1fa2' }} />
            
            <Grid container spacing={2}>
              <Grid item xs={12}>
                <TextField
                  fullWidth
                  multiline
                  rows={2}
                  label="Doenças na família (hipertensão, diabetes, câncer, etc.)"
                  value={formData.q18_doencas_familia}
                  onChange={(e) => handleChange('q18_doencas_familia', e.target.value)}
                />
              </Grid>
              <Grid item xs={12} md={6}>
                <TextField
                  fullWidth
                  label="Pais vivos?"
                  value={formData.q19_pais_vivos}
                  onChange={(e) => handleChange('q19_pais_vivos', e.target.value)}
                />
              </Grid>
              <Grid item xs={12} md={6}>
                <TextField
                  fullWidth
                  label="Doenças dos pais"
                  value={formData.q20_doencas_pais}
                  onChange={(e) => handleChange('q20_doencas_pais', e.target.value)}
                />
              </Grid>
            </Grid>
          </Box>

          {/* Histórico Pessoal */}
          <Box sx={{ mb: 4, p: 3, borderRadius: 2, backgroundColor: '#fff3e0', border: '2px solid #f57c00' }}>
            <Typography variant="h6" gutterBottom sx={{ color: '#f57c00', fontWeight: 600 }}>
              📝 Histórico Pessoal
            </Typography>
            <Divider sx={{ mb: 2, borderColor: '#f57c00' }} />
            
            <Grid container spacing={2}>
              <Grid item xs={12} md={6}>
                <TextField
                  fullWidth
                  multiline
                  rows={2}
                  label="Cirurgias realizadas"
                  value={formData.q21_cirurgias}
                  onChange={(e) => handleChange('q21_cirurgias', e.target.value)}
                />
              </Grid>
              <Grid item xs={12} md={6}>
                <TextField
                  fullWidth
                  multiline
                  rows={2}
                  label="Hospitalizações"
                  value={formData.q22_hospitalizacoes}
                  onChange={(e) => handleChange('q22_hospitalizacoes', e.target.value)}
                />
              </Grid>
              <Grid item xs={12} md={6}>
                <TextField
                  fullWidth
                  multiline
                  rows={2}
                  label="Alergias"
                  value={formData.q23_alergias}
                  onChange={(e) => handleChange('q23_alergias', e.target.value)}
                />
              </Grid>
              <Grid item xs={12} md={6}>
                <TextField
                  fullWidth
                  multiline
                  rows={2}
                  label="Medicamentos em uso"
                  value={formData.q24_medicamentos_uso}
                  onChange={(e) => handleChange('q24_medicamentos_uso', e.target.value)}
                />
              </Grid>
              <Grid item xs={12}>
                <TextField
                  fullWidth
                  multiline
                  rows={2}
