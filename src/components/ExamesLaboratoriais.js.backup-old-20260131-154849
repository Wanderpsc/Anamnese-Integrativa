        console.log(`Busca vazia - Mostrando TODOS os ${exames.length} exames`);
        setExamesFiltrados([...exames]); // Usar spread para criar novo array
        return;
      }
      
      const termo = termoBusca.toLowerCase().trim();
      console.log(`Buscando por: "${termo}"`);
      
      // Se exames ainda vazio, retorna array vazio mas não quebra
      if (exames.length === 0) {
        console.warn('Array de exames está vazio durante busca!');
        setExamesFiltrados([]);
        return;
      }
      
      // Filtrar exames com proteção extra
      const filtrados = exames.filter(exame => {
        if (!exame || !exame.exame) {
          console.warn('Exame inválido encontrado:', exame);
          return false;
        }
        const nomeExame = exame.exame.toLowerCase();
        return nomeExame.includes(termo);
      });
      console.log(`Encontrados ${filtrados.length} exames`);
      if (filtrados.length > 0 && filtrados.length <= 5) {
        console.log('Exames encontrados:', filtrados.map(e => e.exame));
      }
      
      // Ordenar por relevância
      const ordenados = filtrados.sort((a, b) => {
        const nomeA = a.exame.toLowerCase().trim();
        const nomeB = b.exame.toLowerCase().trim();
        
        // 1. Correspondência exata
        if (nomeA === termo && nomeB !== termo) return -1;
        if (nomeA !== termo && nomeB === termo) return 1;
        
        // 2. Começa com o termo
        const aComeca = nomeA.startsWith(termo);
        const bComeca = nomeB.startsWith(termo);
        if (aComeca && !bComeca) return -1;
        if (!aComeca && bComeca) return 1;
        
        // 3. Posição do termo
        const posA = nomeA.indexOf(termo);
        const posB = nomeB.indexOf(termo);
        if (posA !== posB) return posA - posB;
        
        // 4. Nome mais curto
        if (nomeA.length !== nomeB.length) return nomeA.length - nomeB.length;
        
        // 5. Alfabética
        return nomeA.localeCompare(nomeB);
      });
      
      console.log('Setando exames filtrados:', ordenados.length);
      setExamesFiltrados(ordenados);
      console.log('=== FILTRO FIM ===');
      
    } catch (error) {
      console.error('ERRO FATAL NO FILTRO:', error);
      console.error('Stack:', error.stack);
      setExamesFiltrados([]);
    }
  }, [termoBusca]); // REMOVIDO 'exames' e 'loading' para evitar loop infinito

