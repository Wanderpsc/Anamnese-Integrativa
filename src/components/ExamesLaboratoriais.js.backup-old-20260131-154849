      'hemoglobina': {
        'g/dL->g/L': (v) => v * 10,
        'g/L->g/dL': (v) => v / 10
      },
      // HbA1c: % <-> mmol/mol
      'hemoglobina glicada': {
        '%->mmol/mol': (v) => (v - 2.15) * 10.929,
        'mmol/mol->%': (v) => (v / 10.929) + 2.15
      },
      // Leucócitos e Plaquetas: /mm³ <-> mil/mm³ <-> x10³/µL
      'leucócitos': {
        '/mm³->mil/mm³': (v) => v / 1000,
        'mil/mm³->/mm³': (v) => v * 1000,
        '/mm³->x10³/µL': (v) => v / 1000,
        'x10³/µL->/mm³': (v) => v * 1000
      },
      'plaquetas': {
        '/mm³->mil/mm³': (v) => v / 1000,
        'mil/mm³->/mm³': (v) => v * 1000,
        '/mm³->x10³/µL': (v) => v / 1000,
        'x10³/µL->/mm³': (v) => v * 1000
      },
      // Glicemia: mg/dL <-> mmol/L
      'glicemia': {
        'mg/dL->mmol/L': (v) => v / 18,
        'mmol/L->mg/dL': (v) => v * 18
      },
      // Colesterol/Triglicérides: mg/dL <-> mmol/L
      'colesterol': {
        'mg/dL->mmol/L': (v) => v / 38.67,
        'mmol/L->mg/dL': (v) => v * 38.67
      },
      'triglicérides': {
        'mg/dL->mmol/L': (v) => v / 88.57,
        'mmol/L->mg/dL': (v) => v * 88.57
      },
      // TSH: mUI/L <-> µUI/mL (mesma unidade)
      'tsh': {
        'mUI/L->µUI/mL': (v) => v,
        'µUI/mL->mUI/L': (v) => v
      },
      // T3/T4: pg/mL <-> pmol/L, ng/dL <-> pmol/L
      't3 livre': {
        'pg/mL->pmol/L': (v) => v * 1.536,
        'pmol/L->pg/mL': (v) => v / 1.536
      },
      't4 livre': {
        'ng/dL->pmol/L': (v) => v * 12.87,
        'pmol/L->ng/dL': (v) => v / 12.87
      },
      // Ferritina: ng/mL <-> µg/L <-> pmol/L
      'ferritina': {
        'ng/mL->µg/L': (v) => v,
        'µg/L->ng/mL': (v) => v,
        'ng/mL->pmol/L': (v) => v * 2.247,
        'pmol/L->ng/mL': (v) => v / 2.247
      },
      // Vitamina D: ng/mL <-> nmol/L
      'vitamina d': {
        'ng/mL->nmol/L': (v) => v * 2.5,
        'nmol/L->ng/mL': (v) => v / 2.5
      },
      // Vitamina B12: pg/mL <-> pmol/L
      'vitamina b12': {
        'pg/mL->pmol/L': (v) => v * 0.738,
        'pmol/L->pg/mL': (v) => v / 0.738
      },
      // Creatinina: mg/dL <-> µmol/L
      'creatinina': {
        'mg/dL->µmol/L': (v) => v * 88.4,
        'µmol/L->mg/dL': (v) => v / 88.4
      },
      // Ureia: mg/dL <-> mmol/L
      'ureia': {
        'mg/dL->mmol/L': (v) => v / 6.0,
        'mmol/L->mg/dL': (v) => v * 6.0
      },
      // Ácido úrico: mg/dL <-> µmol/L
      'ácido úrico': {
        'mg/dL->µmol/L': (v) => v * 59.48,
        'µmol/L->mg/dL': (v) => v / 59.48
      },
