  const obterValoresPorPerfil = (exame, perfil = perfilPaciente, tipo = 'referencia') => {
    if (!exame) return null;
    
    const valores = tipo === 'referencia' ? exame.valoresReferencia : exame.valoresIdeais;
    
    if (!valores) return null;
    
    // Se valores já é um objeto com min/max, retorna direto (formato antigo)
    if (valores.min !== undefined && valores.max !== undefined) {
      return valores;
    }
    
    // Se é string (formato antigo), parseia
    if (typeof valores === 'string') {
      return parseRange(valores, perfil);
    }
    
    // Se é objeto com perfis, retorna o perfil correto
    if (typeof valores === 'object' && valores[perfil]) {
      return valores[perfil];
    }
    
    // Fallback: tenta usar valores gerais ou masculino adulto
    if (typeof valores === 'object') {
      return valores.masculinoAdulto || valores.femininoAdulto || valores.geral || null;
    }
    
    return null;
  };

  // Função auxiliar para parsear strings de range considerando perfil
  const parseRange = (str, perfil = perfilPaciente) => {
    if (!str) return null;
    
    // Se já é objeto, retorna
    if (typeof str === 'object' && str.min !== undefined) return str;
    
    // Se é objeto com perfis
    if (typeof str === 'object' && str[perfil]) return str[perfil];
    
    // Parse de string no formato "H: 13.5-17.5 | M: 12.0-15.5"
    if (typeof str === 'string') {
      // Tenta encontrar o padrão para o perfil específico
      const patterns = {
        masculinoAdulto: /[HhMm]:\s*(\d+\.?\d*)\s*-\s*(\d+\.?\d*)/,
        femininoAdulto: /[MmFf]:\s*(\d+\.?\d*)\s*-\s*(\d+\.?\d*)/,
        masculinoInfantil: /[IiCc]:\s*(\d+\.?\d*)\s*-\s*(\d+\.?\d*)/,
        femininoInfantil: /[IiCc]:\s*(\d+\.?\d*)\s*-\s*(\d+\.?\d*)/
      };
      
      let match = str.match(patterns[perfil] || /(\d+\.?\d*)\s*-\s*(\d+\.?\d*)/);
      
      // Se não encontrou padrão específico, usa o primeiro range encontrado
      if (!match) {
        match = str.match(/(\d+\.?\d*)\s*-\s*(\d+\.?\d*)/);
      }
      
      if (match) {
        return {
          min: parseFloat(match[1]),
          max: parseFloat(match[2])
        };
      }
    }
    
    return null;
  };

  // Função para converter valores entre diferentes unidades
  const converterUnidade = (valor, unidadeOrigem, unidadeDestino, exame) => {
    if (!valor || unidadeOrigem === unidadeDestino) return valor;
    
