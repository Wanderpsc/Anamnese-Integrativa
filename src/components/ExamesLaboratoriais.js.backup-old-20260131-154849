              </Grid>
              <Grid item xs={4}>
                <Typography variant="body2">
                  <strong>Idade:</strong> {dadosPaciente?.idade || 'N/A'} anos
                </Typography>
              </Grid>
              {dadosPaciente?.dataNasc && (
                <Grid item xs={6}>
                  <Typography variant="body2">
                    <strong>Data Nascimento:</strong> {new Date(dadosPaciente.dataNasc).toLocaleDateString('pt-BR')}
                  </Typography>
                </Grid>
              )}
              {dadosPaciente?.telefone && (
                <Grid item xs={6}>
                  <Typography variant="body2">
                    <strong>Telefone:</strong> {dadosPaciente.telefone}
                  </Typography>
                </Grid>
              )}
            </Grid>
          </Box>
        </Box>

        {/* Título e instruções */}
        <Paper elevation={3} sx={{ p: 3, mb: 3 }} className="no-print">
          <Typography variant="h4" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
            <MedicalServicesIcon fontSize="large" color="primary" />
            📊 Exames Laboratoriais
          </Typography>
          
          <Alert severity="info" sx={{ mb: 3 }}>
            <strong>Sistema Inteligente:</strong> Digite apenas o <strong>Resultado</strong> do paciente. 
            A <strong>Interpretação</strong> e <strong>Conduta</strong> serão geradas automaticamente! 
            ✨ Você pode editar manualmente se desejar.
          </Alert>

          <Box sx={{ display: 'flex', gap: 2, mb: 3 }}>
            <Button
              variant="contained"
              color="primary"
              startIcon={<AssessmentIcon />}
              onClick={() => navigate('/relatorio-exames')}
              sx={{ 
                background: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',
                fontWeight: 600,
                px: 3
              }}
            >
              Ver Relatório Integrativo
            </Button>
          </Box>

          <Grid container spacing={2}>
            <Grid item xs={12} md={6}>
              <TextField
                fullWidth
                label="Nome do Paciente"
                value={pacienteNome}
                onChange={(e) => setPacienteNome(e.target.value)}
                variant="outlined"
              />
            </Grid>
            <Grid item xs={12} md={6}>
              <TextField
                fullWidth
                label="Data do Exame"
                type="date"
                value={dataExame}
                onChange={(e) => setDataExame(e.target.value)}
                variant="outlined"
                InputLabelProps={{ shrink: true }}
              />
            </Grid>
            
            {/* NOVO: Seletor de Perfil do Paciente */}
            <Grid item xs={12} md={6}>
              <FormControl fullWidth variant="outlined">
                <Typography variant="body2" sx={{ mb: 0.5, fontWeight: 600, color: '#1976d2' }}>
                  👤 Perfil do Paciente (para valores de referência)
                </Typography>
                <Select
                  value={perfilPaciente}
                  onChange={(e) => {
                    setPerfilPaciente(e.target.value);
                    // Reprocessar todos os exames com resultados quando mudar o perfil
                    setExames(prev => prev.map(ex => {
                      if (ex.resultadoPaciente && ex.resultadoPaciente.trim() !== '') {
                        const interpretacao = gerarInterpretacao(ex.resultadoPaciente, ex.valoresReferencia, ex.valoresIdeais, ex);
                        const conduta = gerarConduta(ex.exame, interpretacao, parseFloat(ex.resultadoPaciente));
                        return { ...ex, interpretacao, conduta };
                      }
                      return ex;
                    }));
                  }}
                  sx={{ bgcolor: '#e3f2fd' }}
                >
                  <MenuItem value="masculinoAdulto">👨 Masculino Adulto (≥12 anos)</MenuItem>
                  <MenuItem value="femininoAdulto">👩 Feminino Adulto (≥12 anos)</MenuItem>
                  <MenuItem value="masculinoInfantil">👦 Masculino Infantil (&lt;12 anos)</MenuItem>
                  <MenuItem value="femininoInfantil">👧 Feminino Infantil (&lt;12 anos)</MenuItem>
                </Select>
              </FormControl>
            </Grid>
            
            <Grid item xs={12} md={6}>
              <Alert severity="info" sx={{ py: 0.5 }}>
                <Typography variant="caption">
                  <strong>Importante:</strong> Os valores de referência e ideais são ajustados automaticamente 
                  baseado no perfil selecionado conforme literatura médica (Luciana Caxito et al.).
                </Typography>
              </Alert>
            </Grid>
          </Grid>
        </Paper>

        {/* Componente de Correlações Funcionais e Diagnósticos Previstos */}
        <CorrelacoesExames exames={exames} />

        {/* Campo de Busca */}
        <Paper elevation={2} sx={{ p: 2, mb: 3 }}>
          <TextField
            fullWidth
            label="🔍 Buscar Exame"
            placeholder="Digite o nome do exame (ex: Glicemia, Hemoglobina, TSH...)"
            value={termoBusca}
            onChange={(e) => setTermoBusca(e.target.value)}
            variant="outlined"
            autoComplete="off"
            sx={{ 
              '& .MuiOutlinedInput-root': {
                '&:hover fieldset': {
                  borderColor: '#1976d2',
                },
                '&.Mui-focused fieldset': {
                  borderColor: '#1976d2',
                },
              },
            }}
          />
          {termoBusca && (
            <Box sx={{ mt: 1, display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
              <Typography variant="body2" sx={{ color: examesFiltrados.length > 0 ? '#1976d2' : '#d32f2f', fontWeight: 600 }}>
                {examesFiltrados.length > 0 
                  ? `✓ ${examesFiltrados.length} exame(s) encontrado(s) ${termoBusca.length < 3 ? '(continue digitando para refinar)' : ''}`
                  : '✗ Nenhum exame encontrado'}
              </Typography>
              <Button 
                size="small" 
                onClick={() => setTermoBusca('')}
                variant="outlined"
                sx={{ textTransform: 'none' }}
              >
                ✕ Limpar
              </Button>
            </Box>
          )}
          {!termoBusca && (
            <Typography variant="caption" sx={{ mt: 1, display: 'block', color: 'text.secondary' }}>
              💡 Dica: Digite qualquer parte do nome do exame para filtrar. A busca é em tempo real!
            </Typography>
          )}
        </Paper>

        {/* Tabela de Exames */}
        <TableContainer component={Paper} elevation={3} sx={{ mb: 3 }} key={`table-${examesFiltrados.length}-${termoBusca}`}>
          <Table size="small">
            <TableHead>
              <TableRow sx={{ bgcolor: '#1976d2' }}>
                <TableCell sx={{ color: 'white', fontWeight: 'bold', fontSize: '0.8rem', width: '50px', p: 1 }}>
                  Expandir
                </TableCell>
                <TableCell sx={{ color: 'white', fontWeight: 'bold', fontSize: '0.8rem', width: '180px', p: 1 }}>
                  Exame
                </TableCell>
                <TableCell sx={{ color: 'white', fontWeight: 'bold', fontSize: '0.8rem', width: '130px', p: 1 }}>
                  Valores Referência
                </TableCell>
                <TableCell sx={{ color: 'white', fontWeight: 'bold', fontSize: '0.8rem', width: '100px', p: 1 }}>
                  Valores Ideais
                </TableCell>
                <TableCell sx={{ color: 'white', fontWeight: 'bold', fontSize: '0.8rem', width: '90px', p: 1 }}>
                  Resultado
                </TableCell>
                <TableCell sx={{ color: 'white', fontWeight: 'bold', fontSize: '0.8rem', width: '90px', p: 1 }}>
                  Unidade
                </TableCell>
                <TableCell sx={{ color: 'white', fontWeight: 'bold', fontSize: '0.8rem', width: '140px', p: 1 }}>
                  Interpretação
                </TableCell>
              </TableRow>
            </TableHead>
            <TableBody>
              {examesFiltrados.length === 0 ? (
                <TableRow>
                  <TableCell colSpan={7} sx={{ textAlign: 'center', p: 3 }}>
                    <Typography variant="body1" color="text.secondary">
                      {termoBusca 
                        ? `Nenhum exame encontrado para "${termoBusca}"` 
                        : loading 
                          ? 'Carregando exames...' 
                          : 'Nenhum exame disponível'}
                    </Typography>
                  </TableCell>
                </TableRow>
              ) : (
                examesFiltrados.map((exame) => {
                  // Verifica se o nome do exame corresponde EXATAMENTE ao termo buscado
                  // E se há busca ativa (não vazia)
                  const hasBusca = termoBusca && termoBusca.trim() !== '';
                  const isExactMatch = hasBusca && 
                                       exame.exame.toLowerCase().trim() === termoBusca.toLowerCase().trim();
                  
                  return (
                <React.Fragment key={exame.id}>
                  <TableRow 
                    hover 
                    sx={{ 
                      cursor: 'pointer',
                      bgcolor: isExactMatch ? '#fff59d' : (expandedRows[exame.id] ? '#f5f5f5' : 'inherit'),
                      '&:hover': { bgcolor: '#f5f5f5' },
                      transition: 'background-color 0.3s ease'
                    }}
                  >
                    <TableCell sx={{ p: 0.5 }}>
                      <IconButton
                        size="small"
                        onClick={() => toggleRow(exame.id)}
                        sx={{ 
                          transform: expandedRows[exame.id] ? 'rotate(180deg)' : 'rotate(0deg)',
                          transition: 'transform 0.3s'
                        }}
                      >
                        <ExpandMoreIcon />
                      </IconButton>
                    </TableCell>
                    <TableCell sx={{ fontWeight: 600, fontSize: '0.8rem', p: 1 }}>{exame.exame}</TableCell>
                    <TableCell sx={{ fontSize: '0.75rem', p: 1 }}>{formatarValoresParaExibicao(exame, 'referencia')}</TableCell>
                    <TableCell sx={{ fontSize: '0.75rem', color: 'green', fontWeight: 500, p: 1 }}>{formatarValoresParaExibicao(exame, 'ideais')}</TableCell>
                    <TableCell sx={{ p: 0.5 }}>
                      <TextField
                        fullWidth
                        size="small"
                        type="text"
                        inputMode="decimal"
                        value={exame.resultadoPaciente || ''}
                        onChange={(e) => {
                          e.stopPropagation();
                          console.log('✏️ Digitando no exame:', exame.exame, 'Valor:', e.target.value);
                          handleResultadoChange(exame.id, e.target.value);
                        }}
                        onClick={(e) => e.stopPropagation()}
                        onFocus={(e) => {
                          e.stopPropagation();
                          console.log('🎯 Foco no campo:', exame.exame);
                        }}
                        placeholder="Digite"
                        variant="outlined"
                        autoComplete="off"
                        sx={{ bgcolor: '#fffbf0', '& .MuiInputBase-input': { fontSize: '0.8rem', p: 0.75 } }}
                      />
                    </TableCell>
                    <TableCell sx={{ p: 0.5 }}>
                      <FormControl fullWidth size="small">
                        <Select
                          value={exame.unidadeSelecionada || exame.unidade || ''}
                          onChange={(e) => {
                            e.stopPropagation();
                            handleUnidadeChange(exame.id, e.target.value);
                          }}
                          onClick={(e) => e.stopPropagation()}
                          sx={{ 
                            bgcolor: '#e3f2fd', 
                            fontSize: '0.75rem',
                            '& .MuiSelect-select': { p: 0.5 }
                          }}
                        >
                          {(exame.unidadesDisponiveis || ['']).map((unidade, idx) => (
                            <MenuItem key={idx} value={unidade} sx={{ fontSize: '0.75rem' }}>
                              {unidade || '-'}
                            </MenuItem>
                          ))}
                        </Select>
                      </FormControl>
                    </TableCell>
                    <TableCell sx={{ p: 0.5 }}>
                      <TextField
                        fullWidth
                        size="small"
                        value={exame.interpretacao || ''}
                        onChange={(e) => {
                          e.stopPropagation();
                          handleInterpretacaoChange(exame.id, e.target.value);
                        }}
                        onClick={(e) => e.stopPropagation()}
                        placeholder="Auto"
                        variant="outlined"
                        sx={{ 
                          bgcolor: exame.interpretacao?.includes('IDEAL') ? '#e8f5e9' :
                                 exame.interpretacao?.includes('ALTO') ? '#ffebee' :
                                 exame.interpretacao?.includes('BAIXO') ? '#fff3e0' :
                                 '#faf5ff',
                          '& .MuiInputBase-input': { fontSize: '0.75rem', p: 0.75, fontWeight: 600 }
                        }}
                      />
                    </TableCell>
                  </TableRow>
                  
                  {/* Linha expandida com TODOS OS CAMPOS DETALHADOS */}
                  <TableRow>
                    <TableCell colSpan={7} sx={{ p: 0, borderBottom: expandedRows[exame.id] ? '2px solid #e0e0e0' : 'none' }}>
                      <Collapse in={expandedRows[exame.id]} timeout="auto" unmountOnExit>
                        <Box sx={{ p: 3, bgcolor: '#fafafa' }}>
                          <Grid container spacing={3}>
                            {/* FISIOLOGIA E BIOQUÍMICA */}
                            <Grid item xs={12}>
                              <Paper elevation={1} sx={{ p: 2, bgcolor: '#e3f2fd', borderLeft: '4px solid #1976d2' }}>
                                <Typography variant="subtitle1" sx={{ fontWeight: 'bold', color: '#1976d2', mb: 1.5 }}>
                                  🧬 FISIOLOGIA E BIOQUÍMICA
                                </Typography>
                                <Box sx={{ mb: 2 }}>
                                  <Typography variant="body2" sx={{ fontWeight: 600, color: '#0d47a1', mb: 0.5 }}>
                                    Fisiologia:
                                  </Typography>
                                  <Typography variant="body2" sx={{ fontSize: '0.875rem', lineHeight: 1.6, textAlign: 'justify' }}>
                                    {getFisiologiaBioquimica(exame.exame).fisiologia}
                                  </Typography>
                                </Box>
                                <Box>
                                  <Typography variant="body2" sx={{ fontWeight: 600, color: '#0d47a1', mb: 0.5 }}>
                                    Bioquímica:
                                  </Typography>
                                  <Typography variant="body2" sx={{ fontSize: '0.875rem', lineHeight: 1.6, textAlign: 'justify' }}>
                                    {getFisiologiaBioquimica(exame.exame).bioquimica}
                                  </Typography>
                                </Box>
                              </Paper>
                            </Grid>

                            {/* ALTERAÇÕES E SIGNIFICADOS FUNCIONAIS */}
                            <Grid item xs={12}>
                              <Paper elevation={1} sx={{ p: 2, bgcolor: '#fff3e0', borderLeft: '4px solid #f57c00' }}>
                                <Typography variant="subtitle1" sx={{ fontWeight: 'bold', color: '#f57c00', mb: 1 }}>
                                  ⚠️ ALTERAÇÕES E SIGNIFICADOS FUNCIONAIS
                                </Typography>
                                <Typography variant="body2" sx={{ fontSize: '0.875rem', lineHeight: 1.6, textAlign: 'justify' }}>
                                  {getFisiologiaBioquimica(exame.exame).significado}
                                </Typography>
                              </Paper>
                            </Grid>

                            {/* CONDUTA TERAPÊUTICA */}
                            <Grid item xs={12}>
                              <Paper elevation={1} sx={{ p: 2, bgcolor: '#e8f5e9', borderLeft: '4px solid #2e7d32' }}>
                                <Typography variant="subtitle1" sx={{ fontWeight: 'bold', color: '#2e7d32', mb: 1.5 }}>
                                  💊 CONDUTA TERAPÊUTICA INTEGRATIVA / ABORDAGEM NATUROPÁTICA
                                </Typography>
                                <TextField
                                  fullWidth
                                  multiline
                                  rows={12}
                                  value={exame.conduta || ''}
                                  onChange={(e) => handleCondutaChange(exame.id, e.target.value)}
                                  placeholder={exame.resultadoPaciente ? "Gerando protocolo..." : "Digite um resultado acima para gerar automaticamente o protocolo terapêutico completo com nutracêuticos, fitoterapia, homeopatia, florais, frequenciais, dietoterapia e investigações complementares."}
                                  variant="outlined"
                                  sx={{ 
                                    bgcolor: 'white', 
                                    '& .MuiInputBase-input': { 
                                      fontSize: '0.813rem', 
                                      fontFamily: 'monospace',
                                      lineHeight: 1.5
                                    } 
                                  }}
                                />
                              </Paper>
                            </Grid>

                            {/* OBSERVAÇÕES CLÍNICAS */}
                            <Grid item xs={12}>
                              <Paper elevation={1} sx={{ p: 2, bgcolor: '#fce4ec', borderLeft: '4px solid #c2185b' }}>
                                <Typography variant="subtitle1" sx={{ fontWeight: 'bold', color: '#c2185b', mb: 1 }}>
                                  📌 OBSERVAÇÕES CLÍNICAS ADICIONAIS
                                </Typography>
                                <Typography variant="body2" sx={{ fontSize: '0.875rem', lineHeight: 1.6 }}>
                                  {exame.observacoes}
                                </Typography>
                              </Paper>
                            </Grid>
                          </Grid>
                        </Box>
                      </Collapse>
                    </TableCell>
                  </TableRow>
                </React.Fragment>
              );
            }))}

            </TableBody>
          </Table>
        </TableContainer>

        {/* Legenda */}
        <Paper elevation={2} sx={{ p: 2, mb: 3, bgcolor: '#f9f9f9' }} className="no-print">
          <Typography variant="body2" color="text.secondary">
            💡 <strong>Legenda:</strong> Clique na seta de cada exame para expandir Conduta e Observações detalhadas.
            Os valores ideais são baseados em Medicina Funcional.
          </Typography>
          <Typography variant="body2" color="text.secondary" sx={{ mt: 1 }}>
            📊 <strong>Total:</strong> {exames.length} exames cadastrados | 
            ✅ <strong>Preenchidos:</strong> {exames.filter(e => e.resultadoPaciente).length} resultados
          </Typography>
        </Paper>

        {/* Botões de ação */}
        <Box sx={{ display: 'flex', gap: 2, mb: 3 }} className="no-print">
          <Button variant="contained" startIcon={<SaveIcon />} onClick={handleSalvar}>
            Salvar
          </Button>
          <Button variant="contained" color="success" startIcon={<PrintIcon />} onClick={handleImprimir}>
            Imprimir / PDF
          </Button>
          <Button 
            variant="contained" 
            color="secondary" 
            onClick={() => {
              enviarParaTherapySuggestions(exames, pacienteNome);
              alert('✅ Dados enviados para Prescrição e Terapias!\n\nVocê pode agora acessar:\n• Therapy Suggestions\n• Prescription');
            }}
          >
            📤 Enviar para Prescrição
          </Button>
          <Button variant="outlined" startIcon={<DownloadIcon />} onClick={handleDownloadPDF}>
            Download JSON
          </Button>
          <Button 
            variant="outlined" 
            color="error" 
            onClick={() => {
              if (window.confirm('⚠️ Isso vai limpar todos os dados salvos e recarregar os 88 exames padrão. Confirma?')) {
                localStorage.removeItem('examesLaboratoriais');
                window.location.reload();
              }
            }}
          >
            🔄 Resetar Exames
          </Button>
        </Box>
      </div>
    </Box>
  );
};

// Wrapper com tratamento de erro
const ExamesLaboratoriaisWrapper = () => {
  console.log('🌟 ExamesLaboratoriaisWrapper CARREGANDO...');
  
  return (
    <ErrorBoundary>
      <ExamesLaboratoriais />
    </ErrorBoundary>
  );
};

export default ExamesLaboratoriaisWrapper;
