  const formatarValoresParaExibicao = (exame, tipo = 'referencia') => {
    const campo = tipo === 'referencia' ? 'valoresReferencia' : 'valoresIdeais';
    const campoLegado = tipo === 'referencia' ? 'valoresReferenciaLegado' : 'valoresIdeaisLegado';
    const valores = exame[campo];
    
    // Se está no novo formato (objeto)
    if (valores && typeof valores === 'object' && !Array.isArray(valores)) {
      const valoresPerfil = obterValoresPorPerfil(exame, perfilPaciente, tipo);
      if (valoresPerfil) {
        const { min, max } = valoresPerfil;
        const unidade = exame.unidade || '';
        // Formato: "13.5-17.5 g/dL [Masc. Adulto]"
        const perfilLabel = {
          'masculinoAdulto': 'M.Adulto',
          'femininoAdulto': 'F.Adulto',
          'masculinoInfantil': 'M.Infantil',
          'femininoInfantil': 'F.Infantil'
        }[perfilPaciente] || '';
        
        if (max === Infinity) {
          return `> ${min.toFixed(1)} ${unidade} [${perfilLabel}]`;
        } else if (min === 0) {
          return `< ${max.toFixed(1)} ${unidade} [${perfilLabel}]`;
        } else {
          return `${min.toFixed(1)}-${max.toFixed(1)} ${unidade} [${perfilLabel}]`;
        }
      }
    }
    
    // Fallback para formato legado (string)
    return exame[campoLegado] || valores || 'N/A';
  };

