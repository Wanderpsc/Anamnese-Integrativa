        // Calcula quanto excede o ideal (baseado no ideal, interpretação padrão médica)
        const percDistancia = ((valor - idealMax) / idealMax * 100).toFixed(0);
        const distanciaAbsoluta = (valor - idealMax).toFixed(2);
        proximidadeIdeal = `⬆️ ${percDistancia}% acima do máximo ideal (excede ${distanciaAbsoluta})`;
      }
    }
    
    return { quintil, status, descricao, proximidadeIdeal };
