  // Análise por QUINTIL (divide faixa em 5 partes) ao invés de apenas min-max
  const analisarPorQuintil = (valor, rangeRef, rangeIdeal) => {
    if (!rangeRef || isNaN(valor)) return null;
    
    const { min, max } = rangeRef;
    const amplitude = max - min;
    
    // Define os 5 quintis
    const q1 = min;
    const q2 = min + amplitude * 0.25;
    const q3 = min + amplitude * 0.50;  // Mediana
    const q4 = min + amplitude * 0.75;
    const q5 = max;
    
    // Verifica em qual quintil o valor está
    let quintil, status, descricao;
    
    if (valor < q1) {
      quintil = 0;
      status = 'muito-baixo';
      descricao = `Muito Abaixo do Mínimo (< ${q1.toFixed(1)})`;
    } else if (valor >= q1 && valor < q2) {
      quintil = 1;
      status = 'baixo';
      descricao = `Quintil 1 - Baixo (${q1.toFixed(1)} - ${q2.toFixed(1)})`;
    } else if (valor >= q2 && valor < q3) {
      quintil = 2;
      status = 'abaixo-medio';
      descricao = `Quintil 2 - Abaixo da Média (${q2.toFixed(1)} - ${q3.toFixed(1)})`;
    } else if (valor >= q3 && valor < q4) {
      quintil = 3;
      status = 'medio';
      descricao = `Quintil 3 - Médio (${q3.toFixed(1)} - ${q4.toFixed(1)})`;
    } else if (valor >= q4 && valor <= q5) {
      quintil = 4;
      status = 'alto-normal';
      descricao = `Quintil 4 - Alto-Normal (${q4.toFixed(1)} - ${q5.toFixed(1)})`;
    } else {
      quintil = 5;
      status = 'muito-alto';
      descricao = `Muito Acima do Máximo (> ${q5.toFixed(1)})`;
    }
    
    // Comparar com valores ideais se disponível
    let proximidadeIdeal = '';
    if (rangeIdeal) {
      const idealMin = rangeIdeal.min;
      const idealMax = rangeIdeal.max;
      
      if (valor >= idealMin && valor <= idealMax) {
        proximidadeIdeal = `✅ DENTRO DO IDEAL (${idealMin.toFixed(1)}-${idealMax.toFixed(1)})`;
      } else if (valor < idealMin) {
        // Calcula quanto falta para o ideal (baseado no ideal, interpretação padrão médica)
        const percDistancia = ((idealMin - valor) / idealMin * 100).toFixed(0);
        const distanciaAbsoluta = (idealMin - valor).toFixed(2);
        proximidadeIdeal = `⬇️ ${percDistancia}% abaixo do mínimo ideal (falta ${distanciaAbsoluta})`;
