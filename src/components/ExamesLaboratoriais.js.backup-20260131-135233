// Funções auxiliares definidas FORA do componente para evitar problemas de hoisting
const parseRange = (rangeStr) => {
  // Remove unidades (mg/dL, ng/mL, etc)
  const cleaned = rangeStr.replace(/[a-zA-Z/]+$/g, '').trim();
  
  // Tenta extrair range simples (ex: "70-100", "< 200", "> 30")
  if (cleaned.includes('-')) {
    const parts = cleaned.split('-').map(p => parseFloat(p.replace(/[^\d.]/g, '')));
    if (parts.length === 2 && !isNaN(parts[0]) && !isNaN(parts[1])) {
      return { min: parts[0], max: parts[1] };
    }
  }
  
  if (cleaned.startsWith('<')) {
    const val = parseFloat(cleaned.replace(/[^\d.]/g, ''));
    return { min: 0, max: val };
  }
  
  if (cleaned.startsWith('>')) {
    const val = parseFloat(cleaned.replace(/[^\d.]/g, ''));
    return { min: val, max: Infinity };
  }
  
  // Se tem H: e M: (homem e mulher), retorna range masculino por padrão
  if (cleaned.includes('H:') || cleaned.includes('M:')) {
    const hMatch = cleaned.match(/H:\s*([\d.]+)\s*-\s*([\d.]+)/);
    if (hMatch) {
      return { min: parseFloat(hMatch[1]), max: parseFloat(hMatch[2]) };
    }
  }
  
  return null;
};

